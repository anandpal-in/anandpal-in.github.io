---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
{% comment %} Lists every page and article; skips redirects, drafts and the 404 page. Built without plugins. {% endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {% for p in site.html_pages %}{% unless p.url == '/404.html' or p.layout == 'redirect' %}
    <url><loc>{{ p.url | absolute_url }}</loc></url>
    {% endunless %}{% endfor %}
    {% for item in site.writing %}
    <url><loc>{{ item.url | absolute_url }}</loc><lastmod>{{ item.date | date_to_xmlschema }}</lastmod></url>
    {% endfor %}
</urlset>
